# SketchyBar height (28) + y_offset (2)
yabai -m config external_bar all:30:0

FLOAT_WINDOW_GUARD="$HOME/.config/sketchybar/helpers/float_window_guard.sh"

for signal_label in \
  sketchybar_float_guard_created \
  sketchybar_float_guard_focused \
  sketchybar_float_guard_moved \
  sketchybar_float_guard_resized \
  sketchybar_float_guard_deminimized \
  sketchybar_float_guard_space_changed \
  sketchybar_float_guard_display_moved \
  sketchybar_float_guard_display_resized
do
  yabai -m signal --remove "$signal_label" 2>/dev/null || true
done

for signal_spec in \
  'sketchybar_float_guard_created:window_created' \
  'sketchybar_float_guard_focused:window_focused' \
  'sketchybar_float_guard_moved:window_moved' \
  'sketchybar_float_guard_resized:window_resized' \
  'sketchybar_float_guard_deminimized:window_deminimized'
do
  signal_label=$(printf '%s' "$signal_spec" | cut -d: -f1)
  signal_event=$(printf '%s' "$signal_spec" | cut -d: -f2)
  yabai -m signal --add \
    label="$signal_label" \
    event="$signal_event" \
    action="\"$FLOAT_WINDOW_GUARD\" \"\$YABAI_WINDOW_ID\""
done

for signal_spec in \
  'sketchybar_float_guard_space_changed:space_changed' \
  'sketchybar_float_guard_display_moved:display_moved' \
  'sketchybar_float_guard_display_resized:display_resized'
do
  signal_label=$(printf '%s' "$signal_spec" | cut -d: -f1)
  signal_event=$(printf '%s' "$signal_spec" | cut -d: -f2)
  yabai -m signal --add \
    label="$signal_label" \
    event="$signal_event" \
    action="\"$FLOAT_WINDOW_GUARD\" all"
done

SKETCHYBAR_BIN=/opt/homebrew/bin/sketchybar

# The SketchyBar spaces overlay re-reads yabai's state on these events. Keep them
# here: signals added at runtime are lost whenever yabai restarts.
for signal_event in \
  window_created \
  window_focused \
  window_minimized \
  window_deminimized \
  application_terminated \
  application_hidden \
  application_visible \
  space_created \
  space_destroyed \
  space_changed \
  display_added \
  display_removed \
  display_moved \
  display_resized \
  display_changed \
  mission_control_exit
do
  yabai -m signal --remove "sketchybar_spaces_$signal_event" 2>/dev/null || true
  yabai -m signal --add \
    label="sketchybar_spaces_$signal_event" \
    event="$signal_event" \
    action="$SKETCHYBAR_BIN --trigger spaces_refresh"
done

yabai -m signal --remove sketchybar_spaces_window_destroyed 2>/dev/null || true
yabai -m signal --add \
  label=sketchybar_spaces_window_destroyed \
  event=window_destroyed \
  action="$SKETCHYBAR_BIN --trigger spaces_refresh DESTROYED_WINDOW_ID=\$YABAI_WINDOW_ID"

"$FLOAT_WINDOW_GUARD" all >/dev/null 2>&1 || true
